<header class="item-header">
  <img
    class="item-image"
    data-action="editImage"
    src="{{ img }}"
    data-edit="img"
    title="{{ name }}"
    alt="Item Image"
  />
  <div class="header-fields">
    {{#if locked}}
    <h1>{{ name }}</h1>
    {{else}}
    <input
      name="name"
      type="text"
      value="{{ name }}"
      placeholder="{{localize 'WOD6E.Name'}}"
    />
    {{/if}}

    {{> "systems/wod6e/templates/splats/vampire/items/parts/clan-discipline-selection.hbs"}}
  </div>
</header>
