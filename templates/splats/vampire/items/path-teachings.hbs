<section
  class="tab path-teachings {{ tab.cssClass }}"
  data-tab="{{ tab.id }}"
  data-group="{{ tab.group }}"
>
  <label class="path-field">
    {{localize 'WOD6E.VAMPIRE.Teachings'}}
    <textarea
      name="system.teachings"
      rows="3"
      >{{ path.teachings }}</textarea>
  </label>
  <label class="path-resistance-teaching">
    <input
      type="checkbox"
      name="system.resistanceTeaching"
      {{checked
      path.resistanceTeaching}}
    />
    <span>{{localize 'WOD6E.VAMPIRE.ResistanceTeaching'}}</span>
  </label>
</section>
