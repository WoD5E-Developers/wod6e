<section
  class="sheet-part tab {{ tabs.main.cssClass }}"
  data-group="primary"
  data-tab="main"
>
  <div class="left-header">
    <section
      class="sheet-part tab {{ tabs.main.cssClass }}"
      data-group="primary"
      data-tab="main"
    >
      <div class="sheet-field">
        <label>Name:</label>
        <input
          type="text"
          name="system.name"
          value="{{ system.name }}"
        />
      </div>
      <div class="sheet-field">
        <label>Apparent Age:</label>
        <input
          type="text"
          name="system.age.apparent"
          value="{{ system.age.apparent }}"
        />
      </div>
      <div class="sheet-field">
        <label>Actual Age:</label>
        <input
          type="text"
          name="system.age.actual"
          value="{{ system.age.actual }}"
        />
      </div>
      <div class="sheet-field">
        <label>Date of Embrace:</label>
        <input
          type="text"
          name="system.date.embrace"
          value="{{ system.date.embrace }}"
        />
      </div>
      <div class="sheet-field">
        <label>Nostalgic Decade:</label>
        <input
          type="text"
          name="system.date.nostalgic"
          value="{{ system.date.nostalgic }}"
        />
      </div>
    </section>
  </div>
  <div class="middle-header">
    <img
      src="/systems/wod6e/assets/actors/VampireSymbol.webp"
      class="vampire-symbol"
      height="200px"
    />
  </div>
  <div class="right-header">
    <section
      class="sheet-part tab {{ tabs.main.cssClass }}"
      data-group="primary"
      data-tab="main"
    >
      <div class="sheet-field">
        <label>Clan:</label>
        <input
          type="text"
          name="system.clan.name"
          value="{{ system.clan.name }}"
        />
      </div>
      <div class="sheet-field">
        <label>Clan Curse:</label>
        <input
          type="text"
          name="system.clan.curse"
          value="{{ system.clan.curse }}"
        />
      </div>
      <div class="sheet-field">
        <label>Generation (Modifier):</label>
        <input
          type="text"
          name="system.generation"
          value="{{ system.generation }}"
        />
      </div>
      <div class="sheet-field">
        <label>Archetype:</label>
        <input
          type="text"
          name="system.archetype"
          value="{{ system.archetype }}"
        />
      </div>
      <div class="sheet-field">
        <label>Sire:</label>
        <input
          type="text"
          name="system.sire.name"
          value="{{ system.sire.name }}"
        />
      </div>
    </section>
  </div>
</section>
