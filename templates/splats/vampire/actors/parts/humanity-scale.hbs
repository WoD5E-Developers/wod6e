<section
  class="sheet-part sheet-section"
  data-group="primary"
  data-tab="main"
  data-actor-section="humanityScale"
>
  <div
    class="resource-tracker humanity-tracker"
    data-resource="vampire.humanity"
    data-path="system.vampire.humanity"
  >
    <header class="humanity-tracker-header">
      {{localize 'WOD6E.VAMPIRE.HumanityScale'}}
    </header>

    <div class="humanity-scale">
      <span class="humanity-scale-side">
        <div class="resource-tracker-spaces">
          {{#each beastTracker.trackers as |group|}}
          <div class="resource-tracker-group">
            {{#each group as |space|}}
            <button
              type="button"
              class="resource-tracker-space {{#if space.filled}}filled{{/if}}"
              data-action="setTrackerValue"
              data-resource-path="system.vampire.beast"
              data-value="{{ space.trackerValue }}"
              title="{{ space.title }}"
            ></button>
            {{/each}}
          </div>
          {{/each}}
        </div>
        <div class="humanity-scale-side-label">
          {{localize 'WOD6E.VAMPIRE.Beast'}}
        </div>
      </span>

      <div class="resource-tracker-spaces">
        {{localize 'WOD6E.VAMPIRE.Monstrous'}}
        {{#each humanity.trackers as |group|}}
        <div class="resource-tracker-group">
          {{#each group as |space|}}
          <button
            type="button"
            class="resource-tracker-space humanity-position-{{
              space.position
            }} {{#if space.filled}}filled{{/if}} {{#if space.disabled}}tracker-disabled{{/if}} {{#if space.middle}}middle{{/if}}"
            data-action="setTrackerValue"
            data-resource-path="system.vampire.humanity"
            data-value="{{ space.position }}"
            title="{{ space.title }}"
          ></button>
          {{/each}}
        </div>
        {{/each}}
        {{localize 'WOD6E.VAMPIRE.Mortal'}}
      </div>

      <span class="humanity-scale-side">
        <div class="resource-tracker-spaces">
          {{#each natureTracker.trackers as |group|}}
          <div class="resource-tracker-group">
            {{#each group as |space|}}
            <button
              type="button"
              class="resource-tracker-space {{#if space.filled}}filled{{/if}}"
              data-action="setTrackerValue"
              data-resource-path="system.vampire.nature"
              data-value="{{ space.trackerValue }}"
              title="{{ space.title }}"
            ></button>
            {{/each}}
          </div>
          {{/each}}
        </div>
        <div class="humanity-scale-side-label">
          {{localize 'WOD6E.VAMPIRE.Nature'}}
        </div>
      </span>
    </div>
  </div>
</section>
