<section
  class="sheet-part tab sheet-section {{ tabs.main.cssClass }}"
  data-group="primary"
  data-tab="main"
>
  <header class="sheet-section-header">
    <div class="sheet-section-name align-left">
      {{localize 'WOD6E.VAMPIRE.Nature'}}
    </div>
    <div class="sheet-section-data-actions align-right">
      <a
        class="search-data-item"
        data-action="searchItem"
        title="{{localize 'WOD6E.Search'}}"
        data-type="nature"
      >
        <i class="fa-solid fa-magnifying-glass"></i>
      </a>
      <a
        class="item-create"
        data-action="createItem"
        title="{{localize 'WOD6E.Create'}}"
        data-type="nature"
      >
        <i class="fas fa-plus"></i>
      </a>
    </div>
  </header>

  <div class="sheet-section-list">
    {{#each nature as |natureFeature|}}
    <div
      class="sheet-section-row item-section"
      data-nature="{{ natureFeature.uuid }}"
    >
      <button
        type="button"
        class="sheet-section-label"
        data-action="sendItemToChat"
        title="Click to post to chat"
      >
        <span class="item-name bolded">{{ natureFeature.name }}.</span>
      </button>
      {{#if natureFeature.description}}
      <span class="item-description">{{{ descriptionShort natureFeature.description }}}</span>
      {{/if}}
    </div>
    {{/each}}
  </div>
</section>
