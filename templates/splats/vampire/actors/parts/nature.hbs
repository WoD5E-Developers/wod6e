<section
  class="sheet-part tab sheet-section {{ tabs.main.cssClass }}"
  data-group="primary"
  data-tab="main"
>
  <header class="sheet-section-header align-right">
    {{localize 'WOD6E.VAMPIRE.Nature'}}
  </header>

  <div class="sheet-section-list">
    {{#each nature as |natureFeature|}}
    <div
      class="sheet-section-row item-section"
      data-nature="{{ natureFeature.key }}"
    >
      <button
        type="button"
        class="sheet-section-label"
        data-action="sendItemToChat"
        data-nature="{{ natureFeature.key }}"
        title="Click to post to chat"
      >
        <span class="item-name bolded">{{ natureFeature.name }}.</span>
      </button>
      {{#if natureFeature.description}}
      <span class="item-description">{{{ descriptionShort natureFeature.description }}}</span>
      {{/if}}
    </div>
    {{/each}}
  </div>
</section>
