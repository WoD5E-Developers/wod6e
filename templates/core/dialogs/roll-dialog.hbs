<form class="roll-dialog">
  <header class="roll-dialog-header">
    <div class="roll-pool">
      <span class="roll-pool-value">{{ test.dicePoolText }}</span>
    </div>

    <div class="roll-test">
      {{ test.testText }}
    </div>
  </header>

  <div class="roll-dialog-body">
    <div class="form-group multi-select-section attribute-multi-select">
      <label>
        <b>{{localize 'WOD6E.ATTRIBUTES.Attributes'}}</b>
      </label>

      {{> 'systems/wod6e/templates/core/fields/multi-select.hbs'
        fieldPath='attributes'
        options=test.attributeOptions
        selectedText=test.selectedAttributesText
      }}
    </div>

    <div class="form-group multi-select-section skill-multi-select">
      <label>
        <b>{{localize 'WOD6E.SKILLS.Skills'}}</b>
      </label>

      {{> 'systems/wod6e/templates/core/fields/multi-select.hbs'
        fieldPath='skills'
        options=test.skillOptions
        selectedText=test.selectedSkillsText
      }}
    </div>

    <div class="form-group multi-select-section discipline-multi-select">
      <label>
        <b>{{localize 'WOD6E.VAMPIRE.Disciplines'}}</b>
      </label>

      {{> 'systems/wod6e/templates/core/fields/multi-select.hbs'
        fieldPath='disciplines'
        options=test.disciplineOptions
        selectedText=test.selectedDisciplinesText
      }}
    </div>

    <div class="form-group">
      <label>
        <b>{{localize 'WOD6E.ROLL.CustomModifier'}}</b>
      </label>
      <div
        class="custom-modifier-section"
        data-field-path="customModifier"
      >
        <input
          type="number"
          name="customModifier"
          value="0"
          min="0"
          step="1"
        />
      </div>
    </div>
  </div>
</form>
