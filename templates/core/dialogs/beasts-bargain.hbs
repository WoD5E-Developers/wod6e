<div>
  <p class="bargain-instruction">{{localize 'WOD6E.ROLL.BeastsBargainHint'}}</p>
  <label class="bargain-field">
    <span>{{localize 'WOD6E.ROLL.BargainCost'}}</span>
    <textarea
      name="cost"
      rows="5"
      required
    ></textarea>
  </label>
  <label class="bargain-confirmation">
    <input
      type="checkbox"
      name="acceptedByPlayer"
      required
    />
    <span>{{localize 'WOD6E.ROLL.BargainPlayerAccepted'}}</span>
  </label>
</div>
