<section class="sheet-part npc-limited-sheet">
  <img
    class="actor-avatar"
    src="{{ img }}"
    title="{{ name }}"
    alt="{{ name }}"
  />
  <div class="npc-limited-details">
    <h3>{{ name }}</h3>
    {{#if npc.showCreatureType}}
    <div>
      <strong>{{localize "WOD6E.NPC.CreatureType"}}:</strong>
      {{ npc.creatureType }}
    </div>
    {{/if}}
    {{#if npc.showSubtype}}
    <div>
      <strong>{{localize "WOD6E.NPC.Subtype"}}:</strong>
      {{ npc.subtype }}
    </div>
    {{/if}}
    {{#if npc.showMotivation}}
    <section class="motivation-section">
      <h4>{{localize "WOD6E.NPC.Motivation"}}</h4>
      <div>{{{ npc.motivation }}}</div>
    </section>
    {{/if}}
  </div>
</section>
