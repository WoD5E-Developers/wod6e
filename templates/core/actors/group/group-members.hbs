<section
  class="sheet-part tab group-members-page {{ tabs.members.cssClass }}"
  data-group="primary"
  data-tab="members"
>
  <header class="sheet-section-header">
    <span class="sheet-section-name">{{localize "WOD6E.GROUPS.Members"}}</span>
    <span class="group-drop-hint">{{localize "WOD6E.GROUPS.DropActorsHere"}}</span>
  </header>
  <div class="group-member-list">
    {{#each groupMembers as |member|}}
    <div class="group-member {{#unless member.exists}}missing{{/unless}}">
      <img
        src="{{ member.img }}"
        alt="{{ member.name }}"
      />
      <div class="group-member-details">
        <strong>{{ member.name }}</strong>
        <span>{{ member.typeLabel }}</span>
      </div>
      <div class="group-member-actions">
        {{#if member.canOpen}}
        <button
          type="button"
          data-action="openMember"
          data-uuid="{{ member.uuid }}"
          title="{{localize 'WOD6E.GROUPS.OpenMember'}}"
        >
          <i class="fa-solid fa-user"></i>
        </button>
        {{/if}}
        <button
          type="button"
          data-action="removeMember"
          data-uuid="{{ member.uuid }}"
          title="{{localize 'WOD6E.GROUPS.RemoveMember'}}"
        >
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
    </div>
    {{else}}
    <p class="empty-list">{{localize "WOD6E.GROUPS.NoMembers"}}</p>
    {{/each}}
  </div>

  {{> "systems/wod6e/templates/core/actors/group/group-relationships.hbs"}}
</section>
