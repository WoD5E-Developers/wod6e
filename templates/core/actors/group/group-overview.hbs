<section
  class="sheet-part tab group-overview {{ tabs.main.cssClass }}"
  data-group="primary"
  data-tab="main"
>
  <header class="group-header">
    <img
      class="actor-avatar"
      data-action="editImage"
      src="{{ img }}"
      data-edit="img"
      title="{{ name }}"
      alt="{{ name }}"
    />

    <div class="group-header-fields">
      <label>
        <span>{{localize "WOD6E.Name"}}</span>
        <input
          type="text"
          name="name"
          value="{{ name }}"
        />
      </label>

      <label>
        <span>{{localize "WOD6E.GROUPS.GroupType"}}</span>
        <select name="system.subtype">
          {{selectOptions subtypeOptions selected=subtypeSelected valueAttr="key" labelAttr="label"}}
        </select>
      </label>

      {{#if showCoterieFields}}
      <label>
        <span>{{localize "WOD6E.VAMPIRE.CoterieType"}}</span>
        <select name="system.coterieType">
          <option value="">{{localize "WOD6E.NoneSelected"}}</option>
          {{selectOptions coterieTypeOptions selected=coterieTypeSelected valueAttr="key" labelAttr="label"}}
        </select>
      </label>
      {{/if}}

      {{#if showCustomCoterieType}}
      <label>
        <span>{{localize "WOD6E.VAMPIRE.CustomCoterieType"}}</span>
        <input
          type="text"
          name="system.customCoterieType"
          value="{{ customCoterieType }}"
        />
      </label>
      {{/if}}
    </div>
  </header>

  <div class="prose-mirror-section">
    <div class="prose-mirror-header">{{localize "WOD6E.GROUPS.Goals"}}</div>
    <prose-mirror
      name="system.goals"
      value="{{ goals.value }}"
      toggled="true"
    >
      {{{ goals.enriched }}}
    </prose-mirror>
  </div>

  <div class="prose-mirror-section">
    <div class="prose-mirror-header">{{localize "WOD6E.GROUPS.Domain"}}</div>
    <prose-mirror
      name="system.domain"
      value="{{ domain.value }}"
      toggled="true"
    >
      {{{ domain.enriched }}}
    </prose-mirror>
  </div>
</section>
