<section
  class="sheet-part tab sheet-section {{ tabs.main.cssClass }}"
  data-group="primary"
  data-tab="main"
>
  <header class="sheet-section-header">
    <div class="sheet-section-name align-left">
      {{localize 'WOD6E.LIFEPATHS.Lifepaths'}}
    </div>
    <div class="sheet-section-data-actions align-right">
      <a
        class="search-data-item"
        data-action="searchItem"
        title="{{localize 'WOD6E.Search'}}"
        data-type="lifepath"
      >
        <i class="fa-solid fa-magnifying-glass"></i>
      </a>
      <a
        class="item-create"
        data-action="createItem"
        title="{{localize 'WOD6E.Create'}}"
        data-type="lifepath"
      >
        <i class="fas fa-plus"></i>
      </a>
    </div>
  </header>

  <div class="sheet-section-list">
    {{#each lifepaths as |lifepath|}}
    <div
      class="sheet-section-row item-section"
      data-lifepath="{{ lifepath.uuid }}"
    >
      <a
        class="item-open"
        data-action="openItem"
        title="{{localize 'WOD6E.ViewItem'}}"
        data-uuid="{{ lifepath.uuid }}"
      >
        <i class="fas fa-book"></i>
      </a>
      <button
        type="button"
        class="sheet-section-label"
        data-action="sendItemToChat"
        title="Click to post to chat"
      >
        <span class="item-name bolded">{{ lifepath.name }}.</span>
      </button>
      {{#if lifepath.description}}
      <span class="item-description">{{ descriptionShort lifepath.description }}</span>
      {{/if}}
    </div>
    {{/each}}
  </div>
</section>
