<section
  class="sheet-part tab sheet-section {{ tabs.main.cssClass }}"
  data-group="primary"
  data-tab="main"
>
  <header class="sheet-section-header align-center">
    {{localize 'WOD6E.EQUIPMENT.Equipment'}}
  </header>

  <div class="sheet-section-list">
    {{#each equipment as |item|}}
    <div
      class="sheet-section-row item-section"
      data-flaw="{{ item.uuid }}"
    >
      <button
        type="button"
        class="sheet-section-label"
        data-action="sendItemToChat"
        title="Click to post to chat"
      >
        <span class="item-name">{{ item.name }}</span>
      </button>
    </div>
    {{/each}}
  </div>
</section>
