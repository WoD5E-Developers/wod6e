<section
  class="sheet-part tab sheet-section {{ tabs.main.cssClass }}"
  data-group="primary"
  data-tab="main"
>
  <header class="sheet-section-header align-right">
    {{localize 'WOD6E.FLAWS.Flaws'}}
  </header>

  <div class="sheet-section-list">
    {{#each flaws as |flaw|}}
    <div
      class="sheet-section-row item-section"
      data-flaw="{{ flaw.uuid }}"
    >
      <button
        type="button"
        class="sheet-section-label"
        data-action="sendItemToChat"
        title="Click to post to chat"
      >
        <span class="item-name bolded">{{ flaw.name }}.</span>
      </button>
      {{#if flaw.description}}
      <span class="item-description">{{{ descriptionShort flaw.description }}}</span>
      {{/if}}
    </div>
    {{/each}}
  </div>
</section>
