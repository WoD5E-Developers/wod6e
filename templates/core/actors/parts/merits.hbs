<section
  class="sheet-part sheet-section"
  data-group="primary"
  data-tab="main"
  data-actor-section="merits"
>
  <header class="sheet-section-header">
    <div class="sheet-section-name align-left">
      {{localize 'WOD6E.MERITS.Merits'}}
    </div>
    <div class="sheet-section-data-actions align-right">
      <a
        class="search-data-item"
        data-action="searchItem"
        title="{{localize 'WOD6E.Search'}}"
        data-type="merit"
      >
        <i class="fa-solid fa-magnifying-glass"></i>
      </a>
      <a
        class="item-create"
        data-action="createItem"
        title="{{localize 'WOD6E.Create'}}"
        data-type="merit"
      >
        <i class="fas fa-plus"></i>
      </a>
    </div>
  </header>

  <div class="sheet-section-list">
    {{#each merits as |merit|}}
    <div
      class="sheet-section-row item-section"
      data-merit="{{ merit.uuid }}"
    >
      <a
        class="item-open"
        data-action="openItem"
        title="{{localize 'WOD6E.ViewItem'}}"
        data-uuid="{{ merit.uuid }}"
      >
        <i class="fas fa-book"></i>
      </a>
      <button
        type="button"
        class="sheet-section-label"
        data-action="sendItemToChat"
        data-uuid="{{ merit.uuid }}"
        title="{{localize 'WOD6E.PostToChat'}}"
      >
        <span class="item-name bolded">{{ merit.name }}.</span>
      </button>
      {{#if merit.description}}
      <span class="item-description">{{ descriptionShort merit.description }}</span>
      {{/if}}
    </div>
    {{/each}}
  </div>
</section>
