<section
  class="sheet-part tab willpower-section {{ tabs.main.cssClass }}"
  data-group="primary"
  data-tab="main"
>
  <div
    class="resource-tracker willpower-tracker"
    data-resource="willpower"
    data-path="{{ willpower.path }}"
  >
    <header class="resource-tracker-header">
      {{#if showResourceAdjustments}}
        <button
          class="npc-resource-adjust"
          type="button"
          data-action="adjustNpcResourceMax"
          data-resource="willpower"
          data-delta="-1"
          title="{{localize 'WOD6E.RESOURCES.DecreaseResource' resource=(localize 'WOD6E.RESOURCES.Willpower')}}"
        >
          −
        </button>
      {{/if}}
      <span class="resource-tracker-label">{{localize 'WOD6E.RESOURCES.Willpower'}}</span>

      <span class="resource-tracker-total">{{ willpower.value }} / {{ willpower.max }}</span>
      {{#if showResourceAdjustments}}
        <button
          class="npc-resource-adjust"
          type="button"
          data-action="adjustNpcResourceMax"
          data-resource="willpower"
          data-delta="1"
          title="{{localize 'WOD6E.RESOURCES.IncreaseResource' resource=(localize 'WOD6E.RESOURCES.Willpower')}}"
        >
          +
        </button>
      {{/if}}
    </header>

    <div class="resource-tracker-spaces">
      {{#each willpower.trackers as |group|}}
        <div class="resource-tracker-group">
          {{#each group as |space|}}
            <button
              class="
                resource-tracker-space
                {{#if space.filled}}
                  filled
                {{/if}}
                {{#if space.disabled}}
                  blocked
                {{/if}}
              "
              type="button"
              data-action="setTrackerValue"
              data-resource-path="system.willpower"
              data-value="{{ space.trackerValue }}"
              title="{{ space.title }}"
              {{ space.disabledState }}
            ></button>
          {{/each}}
        </div>
      {{/each}}
    </div>
  </div>
</section>
