<section
  class="sheet-part tab health-section {{ tabs.main.cssClass }}"
  data-group="primary"
  data-tab="main"
>
  <div
    class="resource-tracker health-tracker"
    data-resource="health"
    data-path="{{ health.path }}"
  >
    <header class="resource-tracker-header">
      <span class="resource-tracker-label">
        {{localize health.label}}
      </span>

      <span class="resource-tracker-total">({{ health.value }} / {{ health.max }})</span>
    </header>

    <div class="resource-tracker-spaces">
      {{#each health.trackers as |group|}}
      <div class="resource-tracker-group">
        {{#each group as |space|}}
        <button
          type="button"
          class="resource-tracker-space {{#if space.filled}}filled{{/if}} {{#if space.disabled}}tracker-disabled{{/if}}"
          data-action="setTrackerValue"
          data-resource-path="system.health"
          data-value="{{ space.position }}"
          title="{{ space.title }}"
        ></button>
        {{/each}}
      </div>
      {{/each}}
    </div>
  </div>
</section>
