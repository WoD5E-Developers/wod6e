<section
  class="sheet-part sheet-settings tab {{ tabs.settings.cssClass }}"
  data-group="primary"
  data-tab="settings"
>
  {{#if creatureTypeOptions}}
  <div class="form-group">
    <label>{{localize 'WOD6E.NPC.CreatureType'}}</label>
    <select name="system.creatureType">
      {{selectOptions creatureTypeOptions selected=creatureType localize=true}}
    </select>
  </div>
  {{/if}}
  <header class="sheet-section-header">
    <span class="sheet-section-name">{{localize "WOD6E.LimitedVisibility"}}</span>
  </header>
  <p>{{localize "WOD6E.LimitedVisibilityHint"}}</p>
  {{#each limitedSettingFields as |field|}}
  <label>
    <input
      type="checkbox"
      name="system.settings.limited.{{ field.path }}"
      {{checked
      field.checked}}
    />
    <span>{{localize field.label}}</span>
  </label>
  {{/each}}
</section>
