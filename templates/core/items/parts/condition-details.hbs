<section
  class="tab {{ tab.cssClass }}"
  data-tab="{{ tab.id }}"
  data-group="{{ tab.group }}"
>
  <div class="form-group flexrow flex-group-center">
    <label>
      {{localize "WOD6E.CONDITIONS.Stackable"}}
    </label>

    <div class="form-fields">
      <input
        type="checkbox"
        name="system.condition.stacks.stackable"
        {{checked
        condition.stacks.stackable}}
      />
    </div>
  </div>

  {{#if condition.stacks.stackable}}
  <div class="form-group">
    <label>
      {{localize "WOD6E.CONDITIONS.CurrentStacks"}}
    </label>

    <div class="form-fields">
      <input
        type="number"
        name="system.condition.stacks.current"
        value="{{ condition.stacks.current }}"
        min="1"
      />
    </div>
  </div>

  <div class="form-group">
    <label>
      {{localize "WOD6E.CONDITIONS.MaxStacks"}}
    </label>

    <div class="form-fields">
      <input
        type="number"
        name="system.condition.stacks.max"
        value="{{ condition.stacks.max }}"
        min="1"
      />
    </div>
  </div>
  {{/if}}

  <div class="form-group">
    <label>
      {{localize "WOD6E.CONDITIONS.BodyPart"}}
    </label>

    <div class="form-fields">
      <input
        type="text"
        name="system.condition.bodyPart"
        value="{{ condition.bodyPart }}"
        placeholder="{{ localize 'WOD6E.CONDITIONS.BodyPartPlaceholder' }}"
      />
    </div>
  </div>

  <div class="form-group">
    <label>
      {{localize "WOD6E.CONDITIONS.SourceUuid"}}
    </label>

    <div class="form-fields">
      <input
        type="text"
        name="system.condition.sourceUuid"
        value="{{ condition.sourceUuid }}"
      />
    </div>
  </div>

  <div class="form-group">
    <label>
      {{localize "WOD6E.CONDITIONS.TargetUuid"}}
    </label>

    <div class="form-fields">
      <input
        type="text"
        name="system.condition.targetUuid"
        value="{{ condition.targetUuid }}"
      />
    </div>
  </div>
</section>
