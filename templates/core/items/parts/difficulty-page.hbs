<section
  class="tab {{ tab.cssClass }}"
  data-tab="{{ tab.id }}"
  data-group="{{ tab.group }}"
>
  <div class="form-group">
    <label>{{localize "WOD6E.ACTIONS.DifficultyType"}}</label>

    <select name="system.difficulty.type">
      {{selectOptions
        difficultyOptions
        selected=difficultySelected
      }}
    </select>
  </div>

  {{#if difficultyUsesFixedValue}}
  <div class="form-group">
    <label>{{localize "WOD6E.ACTIONS.FixedValue"}}</label>

    <input
      type="number"
      name="system.difficulty.fixed"
      value="{{ difficulty.fixed }}"
      min="0"
      step="1"
    />
  </div>
  {{/if}}

  {{#if difficultyUsesTargetsTrait}}
  <div class="form-group">
    <label>{{localize "WOD6E.ACTIONS.TargetsTrait"}}</label>

    <select name="system.difficulty.targetsTrait">
      {{#each traitGroups as |group|}}
        <optgroup label="{{ group.label }}">
          {{#each group.options as |option|}}
            <option
              value="{{ option.key }}"
              {{#if (eq option.key ../../selectedTrait)}}selected{{/if}}
            >
              {{ option.label }}
            </option>
          {{/each}}
        </optgroup>
      {{/each}}
    </select>
  </div>
  {{/if}}

  {{#if difficultyUsesAttribute}}
  <div class="form-group multi-select-section">
    <label>
      {{#if difficultyUsesMultipleAttributes}}
      {{localize "WOD6E.ATTRIBUTES.Attributes"}}
      {{else}}
      {{localize "WOD6E.ATTRIBUTES.Attribute"}}
      {{/if}}
    </label>

    {{#if difficultyUsesMultipleAttributes}}
    {{> 'systems/wod6e/templates/core/fields/multi-select.hbs'
      fieldPath='system.difficulty.attributes'
      options=attributeOptions
      selectedText=selectedAttributesText
    }}
    {{else}}
    <select name="system.difficulty.singleAttribute">
      {{selectOptions
        attributeOptions
        selected=difficulty.singleAttribute
      }}
    </select>
    {{/if}}
  </div>
  {{/if}}

  {{#if difficultyUsesNpcLevel}}
  <div class="form-group">
    <p class="hint">
      {{localize "WOD6E.ACTIONS.UsesNPCLevel"}}
    </p>
  </div>
  {{/if}}

  {{#if difficultyDeterminedByStoryteller}}
  <div class="form-group">
    <p class="hint">
      {{localize "WOD6E.ACTIONS.DifficultyDeterminedByStoryteller"}}
    </p>
  </div>
  {{/if}}
</section>
