<section
  class="tab {{ tab.cssClass }}"
  data-tab="{{ tab.id }}"
  data-group="{{ tab.group }}"
>
  <select name="system.difficulty.type">
    {{selectOptions actionDifficultyOptions selected=actionDifficultySelected}}
  </select>

  {{#if difficultyUsesFixedValue}}
  <input
    type="number"
    name="system.difficulty.fixed"
    value="{{ difficulty.fixed }}"
    min="0"
  />
  {{/if}}

  {{#if difficultyUsesAttribute}}
  <select name="system.difficulty.attribute">
    {{selectOptions attributeOptions selected=difficulty.attribute}}
  </select>
  {{/if}}

  <label>
    <input
      type="checkbox"
      name="system.difficulty.useNpcLevel"
      {{checked
      difficulty.useNpcLevel}}
    />
    {{localize "WOD6E.ACTIONS.UseNpcLevel"}}
  </label>
</section>
