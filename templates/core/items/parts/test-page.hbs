<section
  class="tab {{ tab.cssClass }}"
  data-tab="{{ tab.id }}"
  data-group="{{ tab.group }}"
>
  <div class="action-test">
    <div class="form-group">
      <label>
        <b>{{localize 'WOD6E.Description'}}</b>
      </label>
      <input
        type="text"
        name="system.test.description"
        value="{{ test.description }}"
      />
    </div>

    <hr />

    <div class="flexrow form-group shared-group-row">
      <div>
        <label>
          <b>{{localize 'WOD6E.MODIFIERS.ModifierSource'}}</b>
        </label>
        <div class="form-fields">
          <select name="system.test.modifier.valueSource">
            {{selectOptions test.modifierSourceOptions selected=test.modifier.valueSource localize=true}}
          </select>
        </div>
      </div>

      {{#if (eq test.modifier.valueSource 'trait')}}
      <div>
        <label>
          <b>{{localize 'WOD6E.CONDITIONS.Mode'}}</b>
        </label>
        <div class="form-fields">
          <select name="system.test.modifier.mode">
            {{selectOptions test.modifierModeOptions selected=test.modifier.mode localize=true}}
          </select>
        </div>
      </div>

      <div>
        <label>
          <b>{{localize 'WOD6E.MODIFIERS.ActorTrait'}}</b>
        </label>
        <div class="form-fields">
          <select name="system.test.modifier.valueTrait">
            <option value="">{{localize 'WOD6E.None'}}</option>
            {{#each test.modifierTraitGroups as |group|}}
            <optgroup label="{{ group.label }}">
              {{#each group.options as |option|}}
              {{#if option.selected}}
              <option
                value="{{ option.key }}"
                selected
              >
                {{ option.label }}
              </option>
              {{else}}
              <option value="{{ option.key }}">{{ option.label }}</option>
              {{/if}}
              {{/each}}
            </optgroup>
            {{/each}}
          </select>
        </div>
      </div>
      {{else}}
      <div>
        <label>
          <b>{{localize 'WOD6E.MODIFIERS.FlatModifier'}}</b>
        </label>
        <div class="form-fields">
          <input
            type="number"
            name="system.test.modifier.value"
            value="{{ test.modifier.value }}"
          />
        </div>
      </div>
      {{/if}}
    </div>

    <hr />

    <div class="form-group">
      <label>
        <b>{{localize 'WOD6E.ACTIONS.Test'}}:</b>
        {{ test.testText }}
      </label>
    </div>

    <div class="form-group multi-select-section">
      <label>
        <b>{{localize 'WOD6E.ATTRIBUTES.Attributes'}}</b>
      </label>

      {{> 'systems/wod6e/templates/core/fields/multi-select.hbs'
      fieldPath='system.test.attributes'
      options=test.attributeOptions
      selectedText=test.selectedAttributesText
      }}
    </div>

    <div class="form-group multi-select-section">
      <label>
        <b>{{localize 'WOD6E.SKILLS.Skills'}}</b>
      </label>

      {{> 'systems/wod6e/templates/core/fields/multi-select.hbs'
      fieldPath='system.test.skills'
      options=test.skillOptions
      selectedText=test.selectedSkillsText
      }}
    </div>

    <div class="form-group multi-select-section">
      <label>
        <b>{{localize 'WOD6E.VAMPIRE.Disciplines'}}</b>
      </label>

      {{> 'systems/wod6e/templates/core/fields/multi-select.hbs'
      fieldPath='system.test.disciplines'
      options=test.disciplineOptions
      selectedText=test.selectedDisciplinesText
      }}
    </div>
  </div>
</section>
