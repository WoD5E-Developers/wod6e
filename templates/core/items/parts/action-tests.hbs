<section
  class="tab {{ tab.cssClass }}"
  data-tab="{{ tab.id }}"
  data-group="{{ tab.group }}"
>
  {{#each tests as |test index|}}
  <div class="action-test-row">
    <div class="form-group multi-select-section">
      <label>
        <b>{{localize 'WOD6E.ATTRIBUTES.Attributes'}}</b>
      </label>

      {{> 'systems/wod6e/templates/core/fields/multi-select.hbs'
        fieldPath='system.tests.{{ index
      }}.attributes' options=attributeOptions selectedText=test.attributes }}
    </div>

    <div class="form-group multi-select-section">
      <label>
        <b>{{localize 'WOD6E.SKILLS.Skills'}}</b>
      </label>

      {{> 'systems/wod6e/templates/core/fields/multi-select.hbs'
        fieldPath='system.tests.{{ index
      }}.skills' options=skillOptions selectedText=test.skills }}
    </div>

    <div class="form-group multi-select-section">
      <label>
        <b>{{localize 'WOD6E.VAMPIRE.Disciplines'}}</b>
      </label>

      {{> 'systems/wod6e/templates/core/fields/multi-select.hbs'
        fieldPath='system.tests.{{ index
      }}.skills' options=disciplineOptions selectedText=test.disciplines }}
    </div>

    <input
      type="text"
      name="system.tests.{{ index }}.description"
      value="{{ test.description }}"
    />
  </div>
  {{/each}}
</section>
