<section
  class="tab {{ tab.cssClass }}"
  data-tab="{{ tab.id }}"
  data-group="{{ tab.group }}"
>
  <div class="item-list-header flexrow">
    <div class="item-controls">
      <a
        data-action="addEffect"
        title="{{localize 'WOD6E.CONDITIONS.AddEffect'}}"
      >
        <i class="fa-solid fa-plus"></i>
      </a>
    </div>
  </div>

  <div class="condition-effect-list">
    {{#each effects as |effect index|}}
    <div
      class="condition-effect"
      data-effect-index="{{ index }}"
    >
      <div class="flexrow">
        <div class="form-group">
          <label>
            {{localize "WOD6E.CONDITIONS.EffectType"}}
          </label>

          <div class="form-fields">
            <select name="system.effects.{{ index }}.type">
              {{selectOptions
                ../effectTypeOptions
                selected=effect.type
                localize=true
              }}
            </select>
          </div>
        </div>

        <div class="form-group multi-select-section">
          <label>
            {{localize "WOD6E.CONDITIONS.Targets"}}
          </label>

          {{> 'systems/wod6e/templates/core/fields/multi-select.hbs'
            fieldPath=(concat 'system.effects.' index '.targets')
            options=effect.targetOptions
            selectedText=effect.selectedTargetsText
          }}
        </div>
      </div>

      <div class="flexrow">
        <div class="form-group">
          <label>
            {{localize "WOD6E.CONDITIONS.Mode"}}
          </label>

          <div class="form-fields">
            <select name="system.effects.{{ index }}.mode">
              {{selectOptions
                ../effectModeOptions
                selected=effect.mode
                localize=true
              }}
            </select>
          </div>
        </div>

        <div class="form-group">
          <label>
            {{localize "WOD6E.CONDITIONS.Value"}}
          </label>

          <div class="form-fields">
            <input
              type="number"
              name="system.effects.{{ index }}.value"
              value="{{ effect.value }}"
              min="0"
            />
          </div>
        </div>
      </div>

      <div class="flexrow">
        <div class="form-group">
          <label>
            {{localize "WOD6E.CONDITIONS.Predicates"}}
          </label>

          <div class="form-fields">
            <input
              type="text"
              name="system.effects.{{ index }}.predicate"
              value="{{ effect.predicateText }}"
              placeholder="category:physical, defense:true"
            />
          </div>
        </div>

        <div class="form-group">
          <label>
            {{localize "WOD6E.CONDITIONS.Excludes"}}
          </label>

          <div class="form-fields">
            <input
              type="text"
              name="system.effects.{{ index }}.excludes"
              value="{{ effect.excludesText }}"
              placeholder="action:dodge"
            />
          </div>
        </div>
      </div>

      <div class="flexrow">
        <div class="form-group">
          <label>
            {{localize "WOD6E.CONDITIONS.AffectsDerived"}}
          </label>

          <div class="form-fields">
            <input
              type="checkbox"
              name="system.effects.{{ index }}.affectsDerived"
              {{checked
              effect.affectsDerived}}
            />
          </div>
        </div>

        <div class="form-group">
          <div class="form-fields">
            <button
              type="button"
              data-action="deleteEffect"
              data-effect-index="{{ index }}"
            >
              <i class="fa-solid fa-trash"></i>
              {{localize "WOD6E.Delete"}}
            </button>
          </div>
        </div>
      </div>
    </div>
    {{else}}
    <div class="empty">
      {{localize "WOD6E.CONDITIONS.NoEffects"}}
    </div>
    {{/each}}
  </div>
</section>
