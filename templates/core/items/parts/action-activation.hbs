<section
  class="tab {{ tab.cssClass }}"
  data-tab="{{ tab.id }}"
  data-group="{{ tab.group }}"
>
  <div class="flexcol action-activation flex-center item-resource">
    <label>
      <b>{{localize "WOD6E.ACTIONS.ActivationType"}}</b>
    </label>
    <select
      name="system.activation.activationType"
      data-type="String"
    >
      {{selectOptions actionActivationOptions selected=actionActivationSelected}}
    </select>
  </div>

  <div class="flexcol action-distance flex-center item-resource">
    <label>
      <b>{{localize "WOD6E.ACTIONS.ActivationDistance"}}</b>
    </label>

    <select name="system.activation.distance">
      {{selectOptions actionDistanceOptions selected=actionDistanceSelected}}
    </select>
  </div>
</section>
