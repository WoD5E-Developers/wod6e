<section
  class="tab {{ tab.cssClass }}"
  data-tab="{{ tab.id }}"
  data-group="{{ tab.group }}"
>
  <div class="flexcol action-activation flex-center item-resource">
    <label>
      <b>{{localize "WOD6E.ACTIONS.ActivationType"}}</b>
    </label>
    <select name="system.activation.activationType">
      {{selectOptions activationOptions selected=activationSelected}}
    </select>
  </div>

  <div class="flexcol action-distance flex-center item-resource">
    <label>
      <b>{{localize "WOD6E.ACTIONS.Distance"}}</b>
    </label>

    <select name="system.activation.distance">
      {{selectOptions distanceOptions selected=distanceSelected}}
    </select>
  </div>

  <div class="flexcol action-duration flex-center item-resource">
    <label>
      <b>{{localize "WOD6E.ACTIONS.Duration"}}</b>
    </label>

    <select name="system.activation.duration">
      {{selectOptions durationOptions selected=durationSelected}}
    </select>
  </div>
</section>
