<header class="item-header">
  {{> "systems/wod6e/templates/core/items/parts/item-image.hbs"}}
  {{> "systems/wod6e/templates/core/items/parts/item-name.hbs"}}

  <div class="header-fields">
    <div class="flexcol flex-center item-resource">
      <label>
        <b>{{localize "WOD6E.NPC.Uses"}}</b>
      </label>

      <input
        type="checkbox"
        name="system.uses.enabled"
        {{checked
        uses.enabled}}
      />
    </div>

    {{#if uses.enabled}}
    <div class="flexcol flex-center item-resource">
      <label>
        <b>{{localize "WOD6E.NPC.CurrentUses"}}</b>
      </label>

      <input
        type="number"
        name="system.uses.value"
        value="{{ uses.value }}"
        min="0"
        step="1"
      />
    </div>

    <div class="flexcol flex-center item-resource">
      <label>
        <b>{{localize "WOD6E.NPC.MaximumUses"}}</b>
      </label>

      <input
        type="number"
        name="system.uses.max"
        value="{{ uses.max }}"
        min="0"
        step="1"
      />
    </div>

    <div class="flexcol flex-center item-resource">
      <label>
        <b>{{localize "WOD6E.NPC.RecoveryPeriod"}}</b>
      </label>

      <select name="system.uses.period">
        {{selectOptions recoveryPeriodOptions selected=recoveryPeriodSelected}}
      </select>
    </div>
    {{/if}}
  </div>
</header>
