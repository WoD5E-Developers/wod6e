<header class="item-header">
  {{> "systems/wod6e/templates/core/items/parts/item-image.hbs"}}
  {{> "systems/wod6e/templates/core/items/parts/item-name.hbs"}}

  <div class="header-fields">
    <div class="flexcol level flex-center item-resource">
      <div>
        <b>{{localize "WOD6E.RESOURCES.Value"}}</b>
      </div>
      <input
        name="system.value"
        value="{{ value }}"
        type="number"
        min="0"
        max="10"
      />
    </div>
    <div class="flexcol feature-type flex-center item-resource">
      <label>
        <b>{{localize "WOD6E.RESOURCES.ResourceType"}}</b>
      </label>
      <select
        name="system.resourceType"
        data-type="String"
      >
        {{selectOptions resourceTypeOptions selected=resourceTypeSelected}}
      </select>
    </div>
  </div>
</header>
