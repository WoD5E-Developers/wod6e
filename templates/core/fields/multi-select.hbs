<div
  class="multi-select"
  data-multi-select
  data-field-path="{{ fieldPath }}"
>
  <button
    type="button"
    class="multi-select-trigger"
    data-action="toggleMultiSelect"
    aria-expanded="false"
  >
    <span class="multi-select-value">
      {{ selectedText }}
    </span>

    <i
      class="fa-solid fa-chevron-down multi-select-icon"
      aria-hidden="true"
    ></i>
  </button>

  <div
    class="multi-select-dropdown"
    hidden
  >
    {{#each options as |option|}}
    <label class="multi-select-option">
      <input
        type="checkbox"
        value="{{ option.key }}"
        data-action="toggleMultiSelectOption"
        {{checked
        option.selected}}
      />

      <span>{{localize option.label}}</span>
    </label>
    {{/each}}
  </div>
</div>
