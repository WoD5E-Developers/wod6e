{
  "singleQuote": true,
  "printWidth": 100,
  "tabWidth": 2,
  "trailingComma": "none",
  "semi": false,
  "arrowParens": "always",
  "endOfLine": "auto",
  "overrides": [
    {
      "files": [
        "*.hbs",
        "*.handlebars"
      ],
      "options": {
        "parser": "handlebars",
        "htmlWhitespaceSensitivity": "strict",
        "bracketSameLine": false,
        "singleQuote": false
      }
    }
  ],
  "plugins": [
    "@poliklot/prettier-plugin-handlebars"
  ]
}
